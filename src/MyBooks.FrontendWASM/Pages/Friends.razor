@page "/friends"
@inject HttpClient Http
@inject UserSession Session

<div class="d-flex align-items-center justify-content-between mb-4">
    <h4 class="text-white fw-semibold mb-0">Friends</h4>
    <button class="btn btn-primary btn-sm" @onclick="() => showAddPanel = !showAddPanel">
        <span class="bi bi-person-plus me-1"></span> Add Friend
    </button>
</div>

@if (showAddPanel)
{
    <div class="card bg-dark border-secondary mb-4" style="background: linear-gradient(180deg, rgb(5,39,103) 0%, #3a0647 70%);">
        <div class="card-body">
            <h6 class="text-white fw-semibold mb-3">Add a Friend</h6>
            @if (addError != null)
            {
                <div class="alert alert-danger py-2" style="font-size:13px;">@addError</div>
            }
            @if (addSuccess != null)
            {
                <div class="alert alert-success py-2" style="font-size:13px;">@addSuccess</div>
            }
            <div class="d-flex gap-2">
                <input class="form-control bg-dark border-secondary text-white"
                       placeholder="Enter nickname"
                       @bind="friendNickname" />
                <button class="btn btn-primary flex-shrink-0" @onclick="AddFriend" disabled="@isAdding">
                    @if (isAdding)
                    {
                        <span class="spinner-border spinner-border-sm"></span>
                    }
                    else
                    {
                        <span>Add</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

@if (isLoading)
{
    <div class="d-flex justify-content-center py-5">
        <div class="spinner-border text-primary" role="status"></div>
    </div>
}
else if (loadError != null)
{
    <div class="alert alert-danger">@loadError</div>
}
else if (!friends.Any())
{
    <div class="text-center py-5">
        <p class="text-white-50">No friends added yet.</p>
    </div>
}
else
{
    <div class="list-group">
        @foreach (var friend in friends)
        {
            var friendName = friend.UserId == currentUser?.Id
                ? GetUserName(friend.FriendId)
                : GetUserName(friend.UserId);

            <div class="list-group-item bg-dark border-secondary d-flex align-items-center justify-content-between" style="background: linear-gradient(180deg, rgb(5,39,103) 0%, #3a0647 70%);">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-circle bg-primary d-flex align-items-center justify-content-center text-white fw-semibold flex-shrink-0"
                         style="width:38px; height:38px; font-size:14px;">
                        @friendName?[0]
                    </div>
                    <span class="text-white fw-medium">@friendName</span>
                </div>
                <button class="btn btn-outline-danger btn-sm"
                        @onclick="() => RemoveFriend(friend)">
                    <span class="bi bi-person-dash me-1"></span>Remove
                </button>
            </div>
        }
    </div>
}

@code {
    private List<UserFriend> friends = new();
    private List<User> allUsers = new();
    private User? currentUser;

    private bool isLoading = true;
    private bool isAdding;
    private bool showAddPanel;

    private string friendNickname = string.Empty;
    private string? loadError;
    private string? addError;
    private string? addSuccess;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            allUsers = await Http.GetFromJsonAsync<List<User>>("users") ?? new();
            currentUser = allUsers.FirstOrDefault(u => u.Name == Session.Nickname);

            if (currentUser != null)
            {
                friends = (await Http.GetFromJsonAsync<List<UserFriend>>($"users/friend?userId={currentUser.Id}") ?? new());
            }
        }
        catch (Exception ex)
        {
            loadError = $"Failed to load friends: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task AddFriend()
    {
        addError = null;
        addSuccess = null;

        if (string.IsNullOrWhiteSpace(friendNickname))
        {
            addError = "Please enter a nickname.";
            return;
        }

        if (friendNickname.Trim().Equals(Session.Nickname, StringComparison.OrdinalIgnoreCase))
        {
            addError = "You cannot add yourself.";
            return;
        }

        var friendUser = allUsers.FirstOrDefault(u =>
            u.Name.Equals(friendNickname.Trim(), StringComparison.OrdinalIgnoreCase));

        if (friendUser == null)
        {
            addError = "User not found.";
            return;
        }

        if (friends.Any(f => f.UserId == friendUser.Id || f.FriendId == friendUser.Id))
        {
            addError = "Already friends.";
            return;
        }

        isAdding = true;

        try
        {
            var response = await Http.PostAsJsonAsync("users/friend", new UserFriend
            {
                UserId = currentUser!.Id!,
                FriendId = friendUser.Id!
            });

            if (response.IsSuccessStatusCode)
            {
                friends = (await Http.GetFromJsonAsync<List<UserFriend>>($"users/friend?userId={currentUser.Id}") ?? new());

                addSuccess = $"{friendUser.Name} added as a friend!";

                friendNickname = string.Empty;
                showAddPanel = false;
            }
            else
            {
                addError = "Failed to add friend.";
            }
        }
        catch (Exception ex)
        {
            addError = $"Error: {ex.Message}";
        }
        finally
        {
            isAdding = false;
        }
    }

    private async Task RemoveFriend(UserFriend friend)
    {
        var response = await Http.DeleteAsync($"users/friend/{friend.Id}");

        if (response.IsSuccessStatusCode)
        {
            friends.Remove(friend);
        }
    }

    private string? GetUserName(string? userId) =>
        allUsers.FirstOrDefault(u => u.Id == userId)?.Name;
}
